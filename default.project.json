{
  "name": "Game Boilerplate",
  "servePort": 34873,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "$path": "src/shared",
      "Packages": { "$path": "Packages" },
      "ReplicaClient": { "$path": "vendor/Replica/src/ReplicatedStorage/ReplicaClient.luau" },
      "ReplicaShared": { "$path": "vendor/Replica/src/ReplicatedStorage/ReplicaShared" }
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "$path": "src/server",
      "ServerPackages": { "$path": "ServerPackages" },
      "ReplicaServer": { "$path": "vendor/Replica/src/ServerScriptService/ReplicaServer.luau" }
    },
    "StarterPlayer": {
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "$path": "src/client"
      }
    }
  }
}
